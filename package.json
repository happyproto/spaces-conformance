{
  "name": "spaces-conformance",
  "private": true,
  "type": "module",
  "description": "An over-the-wire conformance suite for atproto spaces (Proposal 0016).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node cli/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run validate",
    "stack:test": "cli/stack.sh test",
    "run": "node cli/run.ts",
    "verdict": "node cli/verdict.ts"
  },
  "dependencies": {
    "@atcute/multibase": "1.2.5",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@atcute/cbor": "2.3.8",
    "@atcute/cid": "2.5.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
