# Image digests every run uses. A line moves only through a pull request, so
# each result records exactly what it ran against (design ch. 2.3, 6.2).
# The pds.js, ZDS, atproto-pds, reference and PLC digests started from HappyView's interop/images.env at
# 9f084f5c, so the first results were comparable with HappyView's interop runs (docs/parity.md).
# HAP-427 (Nov 13, 2026) moved pds.js, ZDS, atproto-pds and the reference to their newest
# pds-test images, so those four no longer match HappyView's file.

# 3.0.0-beta.14 (65c76e35).
HAPPYVIEW_IMAGE=ghcr.io/gamesgamesgamesgamesgames/happyview@sha256:147a27668f0fc87c2dcfde5103d01f51efe55c329273c8ae7ae292cdb87a7b93
PDSJS_IMAGE=ghcr.io/happyproto/pds-test/pdsjs@sha256:37c16c3499b54b799399118a24154d64e5397ea93a2b4da74c182f133f9e1bca
PDS_SPACES_ALPHA_IMAGE=ghcr.io/happyproto/pds-test/pds-spaces-alpha@sha256:1b3113b40eac2581b8f928bcec8840c8a0912c3a3d90bf3b965a775f8a97067a
ATPROTO_PDS_IMAGE=ghcr.io/happyproto/pds-test/atproto-pds@sha256:0fe098d36c7fd8beedcdc3f68f4f8431eb4571cdf764599ee42520b22fa07a5f
ZDS_IMAGE=ghcr.io/happyproto/pds-test/zds@sha256:2ec90ddaf8a94618a9654e010586ec503d0dd7c3ec23c9a8646e3b28ad2a998f

# Pinned by hand: the build from did-method-plc's next commit after 996e23b
# exits at start ("does not provide an export named 'Database'").
PLC_IMAGE=ghcr.io/happyproto/pds-test/plc@sha256:be4b9b844e460085372b74194d4d6417206f420b1f1d36c8c8ab86b5d8db9ce5

# Helper images, pinned by digest like the rest (Trezy, Nov 19): the nightly
# run reruns only what changed, so a helper moving under a tag would go
# unnoticed. Each is in every scenario fingerprint (harness/fingerprint.ts).
# Multi-arch index digests, from the tag named in each comment, Nov 19, 2026.
# postgres:17
POSTGRES_IMAGE=postgres@sha256:b60e90042aa6b8dbecd58e224b3e36114dbf8ad754465264c2476ad58a86e45c
# caddy:2-alpine
CADDY_IMAGE=caddy@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
# curlimages/curl:8.11.1 (atproto-pds's healthcheck sidecar)
CURL_IMAGE=curlimages/curl@sha256:c1fe1679c34d9784c1b0d1e5f62ac0a79fca01fb6377cdd33e90473c6f9f9a69
# node:24-bookworm-slim (the harness container's base)
HARNESS_BASE_IMAGE=node@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
