ZDS_IMAGE=ghcr.io/happyproto/pds-test/zds@sha256:809bfa1025271946e78c123e8ff99cb48f0a92c4d37485b985631e9d866380d1

# Pinned by hand: the build from did-method-plc's next commit after 996e23b
# exits at start ("does not provide an export named 'Database'").
PLC_IMAGE=ghcr.io/happyproto/pds-test/plc@sha256:be4b9b844e460085372b74194d4d6417206f420b1f1d36c8c8ab86b5d8db9ce5
