    }
  ],
  "deviations_applied": [
    {
      "assertion": "digest.cid-drisl-typed",
      "cause": "space-record-encoding",
      "reason": "createRecord and getRecord return CIDs that differ from DRISL for the two typed fixture records holding integers past 32 bits. The $link and $bytes fixtures, and plain-JSON records, match at this pin. The follow-up comment on the issue (Nov 13) describes the integer case.",
      "spec": "#commit-digest",
      "tracking": "https://tangled.org/chadtmiller.com/pds.js/issues/4",
      "since": "2026-11-12",
      "expect": {
        "message": "2 record CID\\(s\\) differ from DRISL",
        "evidence": {
          "mismatches": "\\[\\{\"record\":\"bigint\",[^{}]*\"getRecord\":\"bafy[^\"]+\"\\},\\{\"record\":\"int32edge\",[^{}]*\"getRecord\":\"bafy[^\"]+\"\\}\\]"
        }
      }
    },
    {
      "assertion": "oplog.pagination-complete",
      "cause": "oplog-cursor-ignored",
      "reason": "listRepoOps ignores cursor, so following it repeats the first page. The lexicon says cursor takes precedence over since.",
      "spec": "#incremental-sync",
      "tracking": "https://tangled.org/chadtmiller.com/pds.js/issues/5",
      "since": "2026-11-12",
      "expect": {
        "message": "following cursor with limit=2 returned p0 2 times, not once",
        "evidence": {
          "pages": "\\[2,2\\]"
        }
      }
    },
    {
      "assertion": "oplog.pagination-batch-boundary",
      "cause": "oplog-cursor-ignored",
      "reason": "Paging with limit=2 across one three-op applyWrites batch, following cursor, returned m1, m2, m1, m2: the first page twice, and m3 never.",
      "spec": "#incremental-sync",
      "tracking": "https://tangled.org/chadtmiller.com/pds.js/issues/5",
      "since": "2026-11-12",
      "expect": {
        "message": "a page boundary inside one applyWrites batch lost ops: got \\[m1, m1, m2, m2\\]",
        "evidence": {
          "pages": "\\[2,2\\]"
        }
      }
    },
    {
      "assertion": "oplog.fold-matches-commit",
      "cause": "oplog-cursor-ignored",
      "reason": "The fold reads listRepoOps with limit=2 and follows cursor. The first page comes back twice (a, b, a, b), so the fold never sees the later ops and its digest differs from the commit's data. Unpaged reads of the same writes match.",
      "spec": "#incremental-sync",
      "tracking": "https://tangled.org/chadtmiller.com/pds.js/issues/5",
      "since": "2026-11-13",
      "expect": {
        "message": "folding every op does not give the commit data",
        "evidence": {
          "ops": "\\[\\{[^{}]*\"rkey\":\"a\"[^{}]*\\},\\{[^{}]*\"rkey\":\"b\"[^{}]*\\},\\{[^{}]*\"rkey\":\"a\"[^{}]*\\},\\{[^{}]*\"rkey\":\"b\"[^{}]*\\}\\]"
        }
      }
    }
  ],
