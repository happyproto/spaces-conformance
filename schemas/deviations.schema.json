{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyproto/spaces-conformance/schemas/deviations.schema.json",
  "title": "Known deviations",
  "description": "An implementation's deviation list (design ch. 4.3). Cross-checks against the catalogue are in harness/deviations.ts.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["assertion", "cause", "reason", "spec", "tracking", "since"],
    "properties": {
      "assertion": { "type": "string" },
      "cause": { "description": "Groups entries that one fix closes.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "reason": { "type": "string", "minLength": 10 },
      "spec": { "description": "Anchor in the pinned proposal.", "type": "string", "pattern": "^#[a-z0-9-]+$" },
      "tracking": {
        "description": "An issue: HAP-123, HAP-388 (PR 6), owner/repo#12, or an https URL.",
        "type": "string",
        "pattern": "^(HAP-[0-9]+|[\\w.-]+/[\\w.-]+#[0-9]+|https://\\S+)( \\([^)]+\\))?$"
      },
      "since": { "type": "string", "format": "date" }
    }
  }
}
