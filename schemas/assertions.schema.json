{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/happyproto/spaces-conformance/schemas/assertions.schema.json",
  "title": "Assertion catalogue",
  "description": "spec/assertions.yaml. Shape only: the level rule, quote and anchor checks are in harness/catalogue.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "assertions"
  ],
  "properties": {
    "revision": {
      "description": "The base revision (a key in spec/revisions.json): rows read as of this one unless their since is later. Every revision in spec/revisions.json is checked.",
      "type": "string"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "repo-host",
        "space-host",
        "pds"
      ]
    },
    "profile": {
      "enum": [
        "pds",
        "bespoke-space-host"
      ]
    },
    "basis": {
      "enum": [
        "keyword",
        "definition",
        "lexicon",
        "host-honours-may",
        "default"
      ]
    },
    "suite": {
      "enum": [
        "addressing",
        "records",
        "digest",
        "mac",
        "oplog",
        "export",
        "lifecycle",
        "credentials",
        "scopes",
        "writer-set",
        "policy",
        "deletion",
        "migration",
        "pairing"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suite",
        "level",
        "roles",
        "checks",
        "areas"
      ],
      "properties": {
        "id": {
          "description": "Stable dotted id. Never reused.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
        },
        "suite": {
          "$ref": "#/$defs/suite"
        },
        "section": {
          "description": "Heading anchor in the pinned proposal, e.g. #incremental-sync. Omitted only for lexicon rows and info rows.",
          "type": "string",
          "pattern": "^#[a-z0-9-]+$"
        },
        "quote": {
          "description": "The sentence under test, copied from the pinned revision. Markdown emphasis, code spans and links may be kept or dropped.",
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "must",
            "should",
            "info"
          ]
        },
        "basis": {
          "description": "Why the level is what it is. Required for must and should.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/basis"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "profiles": {
          "description": "Defaults to every profile.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requires": {
          "description": "Capability paths the implementation must claim, resolved against its manifest's capabilities, e.g. policies.managedspace, oauth.scripted.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
          },
          "uniqueItems": true
        },
        "lexicon": {
          "description": "Lexicon NSID or NSIDs, when basis includes lexicon. Each must exist in the revision's pinned lexicons.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+\\.[a-zA-Z][a-zA-Z0-9]*$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+\\.[a-zA-Z][a-zA-Z0-9]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "checks": {
          "description": "What the test does, in one or two sentences.",
          "type": "string",
          "minLength": 1
        },
        "since": {
          "description": "First revision the assertion applies to (a key in spec/revisions.json). Defaults to the catalogue's base revision.",
          "type": "string"
        },
        "until": {
          "description": "Last revision the assertion applies to, inclusive.",
          "type": "string"
        },
        "ended": {
          "description": "Why the row stops at its until, when its citation still reads the same in a later revision (the validator refuses such an until without it).",
          "type": "string",
          "minLength": 1
        },
        "provisional": {
          "description": "Marks a row provisional by hand. The lineage rule (harness/independence.ts) applies regardless.",
          "type": "boolean"
        },
        "params": {
          "description": "Parameters or input fields the row relies on. Each must be defined by every listed lexicon.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "error": {
          "description": "For xrpc.error.* rows: the error name, declared by the listed lexicon.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "no_crypto": {
          "description": "Why a row in a crypto suite (digest, mac, export) has areas: []. Required for that case only.",
          "type": "string",
          "minLength": 10
        },
        "areas": {
          "description": "Harness crypto areas the check relies on, or [] to acknowledge it uses none. Required on every row. While any listed area has a pending cross-check (vectors/*.json), the assertion is provisional.",
          "type": "array",
          "items": {
            "enum": [
              "cbor",
              "lthash",
              "mac",
              "httpsig",
              "jwt",
              "star"
            ]
          },
          "uniqueItems": true
        },
        "variants": {
          "description": "Per revision key, the fields that read differently from that revision on. Each variant applies over the row and the variants before it.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "section": {
                "$ref": "#/$defs/assertion/properties/section"
              },
              "quote": {
                "$ref": "#/$defs/assertion/properties/quote"
              },
              "level": {
                "$ref": "#/$defs/assertion/properties/level"
              },
              "basis": {
                "$ref": "#/$defs/assertion/properties/basis"
              },
              "lexicon": {
                "$ref": "#/$defs/assertion/properties/lexicon"
              },
              "params": {
                "$ref": "#/$defs/assertion/properties/params"
              },
              "error": {
                "$ref": "#/$defs/assertion/properties/error"
              },
              "checks": {
                "$ref": "#/$defs/assertion/properties/checks"
              },
              "areas": {
                "$ref": "#/$defs/assertion/properties/areas"
              },
              "no_crypto": {
                "$ref": "#/$defs/assertion/properties/no_crypto"
              }
            }
          }
        }
      }
    }
  }
}
