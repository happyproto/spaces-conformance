---
// One implementation (design ch. 8.1): what it claims and what that rules
// out, its score per role, the run behind it (image digest, source
// revision, a link to the CI run), its deviations by cause with each
// entry's age, every row by suite, and the last 90 days.
import Base from '../../layouts/Base.astro'
import Digest from '../../components/Digest.astro'
import History from '../../components/History.astro'
import Meter from '../../components/Meter.astro'
import State from '../../components/State.astro'
import { assertionHref, data, day, graded, KIND_LABEL, latestRuns, moment, pct, shortDigest, trackingUrl, type Impl, type Group } from '../../lib/data'

export function getStaticPaths() {
  return data.implementations.map((impl) => ({ params: { id: impl.id }, props: { impl } }))
}
interface Props { impl: Impl }
const { impl } = Astro.props
const runs = latestRuns(impl)
const ROLE_LABEL: Record<string, string> = { pds: 'PDS', 'repo-host': 'Repo host', 'space-host': 'Space host' }
const PROFILE_LABEL: Record<string, string> = { pds: 'PDS: each space belongs to a user’s own account', 'bespoke-space-host': 'Standalone space host: spaces live on DIDs it creates' }
const OLD_DAYS = 30
const LEVEL: Record<string, string> = { must: 'required', should: 'recommended', info: 'info' }
const runLink = (r: { ci_url: string | null }) => r.ci_url
const order: Group[] = ['fail', 'deviation', 'provisional', 'error', 'pass', 'pending', 'untested', 'na']
---
<Base title={impl.name} description={`How ${impl.name} does against the atproto spaces spec: its scores, its known gaps and every test.`}>
  <div class="page-head">
    <p class="crumbs"><a href="/">Results</a> / {impl.name}</p>
    <h1>{impl.name}</h1>
    <dl class="facts">
      <div><dt>Jobs</dt><dd>{impl.roles.map((r) => ROLE_LABEL[r] ?? r).join(', ')}</dd></div>
      <div><dt>Kind of host</dt><dd>{PROFILE_LABEL[impl.profile] ?? impl.profile}</dd></div>
      <div><dt>Targets spec</dt><dd>{impl.spec_revisions.join(', ')}</dd></div>
      {(impl.homepage || impl.source) && (
        <div><dt>Project</dt><dd>
          {impl.homepage && <a href={impl.homepage}>Homepage</a>}
          {impl.homepage && impl.source && ' · '}
          {impl.source && <a href={impl.source}>Source</a>}
        </dd></div>
      )}
    </dl>
  </div>

  {impl.limits.length > 0 && (
    <section aria-labelledby="limits">
      <aside class="hp-callout" data-kind="note">
        <p class="hp-callout-title" id="limits">What doesn&rsquo;t apply here</p>
        <ul class="limits">{impl.limits.map((l) => <li>{l}</li>)}</ul>
      </aside>
    </section>
  )}

  {runs.length === 0 && (
    <section>
      <div class="hp-window"><div class="hp-window-body flush"><div class="empty">
        <h3>No results yet</h3>
        <p>We haven&rsquo;t tested this one yet. Its results will show up here after the first run.</p>
      </div></div></div>
    </section>
  )}

  {runs.map(({ revision, run }) => {
    const candidate = impl.candidates[revision]
    return (
      <section aria-labelledby={`rev-${revision}`}>
        <div class="section-head">
          <h2 id={`rev-${revision}`}>Spec revision {revision}</h2>
          <p>{KIND_LABEL[run.kind]} on {moment(run.started_at)}{run.slow ? '' : ', skipping the slow checks'}.</p>
        </div>

        <dl class="scores">
          {Object.entries(run.summary).map(([role, s]) => (
            <div class="score">
              <dt>{ROLE_LABEL[role] ?? role}</dt>
              <dd>
                <span class="hp-figure">{pct(s.must_pass, s.must_applicable)}<span class="hp-figure-unit">of required checks</span></span>
                <span class="detail">{s.must_pass} of {s.must_applicable} pass{s.should_applicable ? `, plus ${s.should_pass} of ${s.should_applicable} recommended` : ''}</span>
              </dd>
            </div>
          ))}
        </dl>

        <div class="block">
          <h3 class="sr-only">The run</h3>
          <dl class="facts">
            <div class="facts-wide"><dt>Image</dt><dd><Digest image={run.image} /></dd></div>
            <div><dt>Source revision</dt><dd>{run.source_revision ? <code>{run.source_revision.slice(0, 12)}</code> : <span class="muted">not recorded</span>}</dd></div>
            <div><dt>Run</dt><dd>{runLink(run) ? <a href={runLink(run)!}>CI run and logs</a> : <span class="muted">Run locally, so there&rsquo;s no CI log</span>}</dd></div>
            <div><dt>Run id</dt><dd><code>{run.id}</code></dd></div>
            <div><dt>Suite commit</dt><dd><a href={`https://github.com/happyproto/spaces-conformance/tree/${run.suite_commit}`}><code>{run.suite_commit}</code></a></dd></div>
            {run.fingerprint && <div><dt>Fingerprint</dt><dd><code title={run.fingerprint}>{run.fingerprint.slice(7, 19)}</code></dd></div>}
            <div><dt>Setup</dt><dd>spaces {run.setup_mode.spaces}, accounts {run.setup_mode.accounts}, writes by {run.write_auth}</dd></div>
            <div><dt>Also in the stack</dt><dd>{run.peers.map((p, i) => <>{i > 0 && ', '}{p.id}{p.as ? ` as ${p.as}` : ''} <Digest image={p.image} short /></>)}</dd></div>
            {run.previous_attempts.length > 0 && <div class="facts-wide"><dt>Earlier attempt</dt><dd>Rerun after {run.previous_attempts.map((a) => `${a.errored.length} error(s) and ${a.failed.length} fail(s) in ${a.id}`).join('; ')}</dd></div>}
          </dl>
          {impl.pinned_image && run.image !== impl.pinned_image && (
            <aside class="hp-callout" data-kind="caution" style="margin-block-start: var(--hp-space-6)">
              <p class="hp-callout-title">These results are from an earlier image</p>
              <p>
                We now test <Digest image={impl.pinned_image} short />, but it hasn’t run yet. Until it does, this page shows the
                last run of <Digest image={run.image} short />.
              </p>
            </aside>
          )}
          {candidate && (
            <aside class="hp-callout" data-kind="note" style="margin-block-start: var(--hp-space-6)">
              <p class="hp-callout-title">We tested a newer image on {day(candidate.started_at)}</p>
              {candidate.infrastructure || candidate.total.error > 0 ? (
                <p>
                  Something broke on our side during that run, so it doesn’t count, and we’re staying on the current image.
                  {candidate.ci_url && <> <a href={candidate.ci_url}>See the run</a>.</>}
                </p>
              ) : (
                <p>
                  <Digest image={candidate.image} short /> passed {candidate.total.pass} of {graded(candidate.total)} tests.
                  {candidate.unexpected === 0 ? ' Nothing surprising, so we’ll switch to it once the pin PR merges.' : ` ${candidate.unexpected} ${candidate.unexpected === 1 ? 'result was' : 'results were'} unexpected, so we’re staying on the current image for now.`}
                  {candidate.ci_url && <> <a href={candidate.ci_url}>See the run</a>.</>}
                </p>
              )}
            </aside>
          )}
        </div>

        {run.deviations.length > 0 && (
          <div class="block">
            <div class="section-head">
              <h3>Known deviations</h3>
              <p>
                {run.deviations.reduce((n, c) => n + c.entries.length, 0)} failing tests the project already knows about, from {run.deviations.length} {run.deviations.length === 1 ? 'cause' : 'causes'}.
                They still count against the score.
              </p>
            </div>
            <div class="causes">
              {run.deviations.map((c) => (
                <article class="cause">
                  <div class="cause-head">
                    <h3><code>{c.cause}</code></h3>
                    <span class="muted small">{c.entries.length} {c.entries.length === 1 ? 'test' : 'tests'}</span>
                  </div>
                  <ul>
                    {c.entries.map((e) => (
                      <li>
                        <span><a href={assertionHref(e.assertion)}><code>{e.assertion}</code></a>: {e.reason}</span>
                        <span class="entry-meta">
                          <span>Tracking: {trackingUrl(e.tracking) ? <a href={e.tracking}>{e.tracking.replace(/^https?:\/\//, '')}</a> : e.tracking}</span>
                          <span class="age" data-old={String(e.age_days > OLD_DAYS)}>Known for {e.age_days === 0 ? 'less than a day' : `${e.age_days} ${e.age_days === 1 ? 'day' : 'days'}`} at this run (since {e.since})</span>
                          
                        </span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        )}

        <div class="block">
          <div class="section-head">
            <h3>All tests</h3>
          </div>
          {data.suites.filter((s) => run.rows.some((r) => r.suite === s)).map((s) => {
            const t = run.bySuite[s]
            const untested = run.rows.filter((r) => r.suite === s && r.group === 'untested')
            const rows = run.rows.filter((r) => r.suite === s && r.group !== 'untested').sort((a, b) => order.indexOf(a.group as Group) - order.indexOf(b.group as Group) || (a.id < b.id ? -1 : 1))
            return (
              <div class="suite-block" id={`suite-${s}`}>
                <h3>
                  {s}
                  <span class="muted">{graded(t) ? `${t.pass} of ${graded(t)} pass` : 'nothing tested yet'}{t.pending ? `, ${t.pending} pending` : ''}{t.untested ? `, ${t.untested} without a test yet` : ''}{t.na ? `, ${t.na} don’t apply` : ''}</span>
                </h3>
                {graded(t) > 0 && <div style="max-inline-size: 16rem; margin-block-end: var(--hp-space-3)"><Meter tally={t} /></div>}
                {rows.length > 0 && <div class="rows-wrap">
                  <table class="rows">
                    <thead><tr><th class="col-state">Result</th><th class="col-id">Test</th><th class="col-level">Level</th><th>What we saw</th></tr></thead>
                    <tbody>
                      {rows.map((r) => (
                        <tr>
                          <td class="col-state"><State group={r.group as Group} label={r.display} /></td>
                          <td class="col-id"><a href={assertionHref(r.id)}><code>{r.id}</code></a></td>
                          <td class="col-level">{LEVEL[r.level] ?? r.level}</td>
                          <td class="why">
                            {r.message ?? ''}
                            {r.changed && <span class="note">A known gap, but it failed in a new way: {r.changed}</span>}
                            {r.provisional && <span class="note">Not counted yet: {r.provisional}</span>}
                            {(r.group === 'fail' || r.group === 'error') && runLink(run) && <span class="note"><a href={runLink(run)!}>See the failing run</a></span>}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>}
                {untested.length > 0 && (
                  <p class="untested small">
                    <State group="untested" label={`${untested.length} ${untested.length === 1 ? 'check doesn’t' : 'checks don’t'} have a test yet`} />
                    <span class="ids">{untested.map((r) => <a href={assertionHref(r.id)}><code>{r.id}</code></a>)}</span>
                  </p>
                )}
              </div>
            )
          })}
        </div>

        <div class="block">
          <div class="section-head"><h3>History</h3></div>
          <History runs={impl.history} revision={revision} />
          <div class="rows-wrap" style="margin-block-start: var(--hp-space-4)">
            <table class="rows">
              <thead><tr><th>Run</th><th>Kind</th><th>Image</th><th>Passing</th></tr></thead>
              <tbody>
                {impl.history.filter((h) => h.revision === revision).map((h) => (
                  <tr>
                    <td>{h.ci_url ? <a href={h.ci_url}>{day(h.started_at)}</a> : day(h.started_at)}</td>
                    <td>{KIND_LABEL[h.kind]}</td>
                    <td><code title={h.image}>{shortDigest(h.image)}</code></td>
                    <td style="font-variant-numeric: var(--hp-font-numeric)">{h.total.pass} of {graded(h.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  })}
</Base>
