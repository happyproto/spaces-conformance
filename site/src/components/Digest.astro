---
// An image reference: the repository, then the digest, both in the mono, so
// the whole thing can be selected and copied.
interface Props { image: string; short?: boolean }
const { image, short = false } = Astro.props
const [repo, digest = ''] = image.split('@')
---
{short
  ? <code class="digest" title={image}>{digest.replace(/^sha256:/, '').slice(0, 12)}</code>
  : <code class="digest digest-full"><span class="digest-repo">{repo}</span><wbr />@<span class="digest-hash">{digest}</span></code>}
